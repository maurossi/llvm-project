cc_defaults {
    name: "llvm20-defaults",
    defaults: ["llvm20-defaults-no-generated-headers"],
    header_libs: ["llvm20-headers"],
}

// This module defines all of the defaults used to compiled llvm, except for
// the generated headers.  It is necessary to avoid a circular dependency
// from the tblgen tool used to generate the headers to the generated headers.
llvm_defaults {
    name: "llvm20-defaults-no-generated-headers",

    host_supported: true,

    cflags: [
        "-D_GNU_SOURCE",
        "-D__STDC_LIMIT_MACROS",
        "-D__STDC_CONSTANT_MACROS",
        "-D__STDC_FORMAT_MACROS",
        "-fomit-frame-pointer",
        "-Wall",
        "-W",
        "-Wno-sign-compare",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-maybe-uninitialized",
        "-Wno-missing-field-initializers",
        "-Wwrite-strings",
        "-Werror",
        "-Dsprintf=sprintf",
        "-DLLVM_WINDOWS_PREFER_FORWARD_SLASH=0",

        // Temporarily suppress the warnings http://b/37867503
        "-Wno-error=unused-lambda-capture",
        "-Wno-error=user-defined-warnings",
        // Avoid build error for llvm/lib/Target/AMDGPU/SIFormMemoryClauses.cpp (Android S)
        "-Wno-error=unreachable-code-loop-increment",
    ],

    cppflags: [
        "-Wno-sign-promo",
        "-std=c++17",
    ],

    header_libs: ["llvm20-headers-no-generated-headers"],

    target: {
        android: {
            cflags: [
                "-finline-functions",
            ],
            cppflags: [
                "-Woverloaded-virtual",
            ],
        },
        host: {
            cppflags: [
                "-fno-rtti",
                "-fno-exceptions",
            ],
        },
        windows: {
            // Disable certain warnings for use with mingw.
            // We also must undefine WIN32_LEAN_AND_MEAN, since it is being passed globally
            // on the command line, and LLVM defines this internally itself.
            cflags: [
                "-Wno-array-bounds",
                "-Wno-comment",
                "-UWIN32_LEAN_AND_MEAN",
            ],

            host_ldlibs: ["-luuid"],
        },
        linux: {
            cppflags: ["-Woverloaded-virtual"],

            // Add on ncurses to have support for terminfo
            host_ldlibs: [
                "-ldl",
                "-lncurses",
                "-lgcc_s",
            ],
        },
        darwin: {
            cppflags: [
                "-Wno-deprecated-declarations",
                "-Woverloaded-virtual",
            ],

            // Add on ncurses to have support for terminfo
            host_ldlibs: [
                "-ldl",
                "-lncurses",
            ],
        },
    },
}

cc_library_headers {
    name: "llvm20-headers-no-generated-headers",
    vendor_available: true,
    host_supported: true,
    export_include_dirs: ["include"],
    target: {
        android: {
            export_include_dirs: ["device/include"],
        },
        host: {
            export_include_dirs: ["host/include"],
        },
        linux_bionic: {
            enabled: true,
        },
        windows: {
            enabled: true,
        },
    },
}

cc_library_headers {
    name: "llvm20-headers",
    vendor_available: true,
    host_supported: true,
    header_libs: ["llvm20-headers-no-generated-headers"],
    export_header_lib_headers: ["llvm20-headers-no-generated-headers"],
    generated_headers: [
        "llvm20-gen-attributes",
        "llvm20-gen-intrinsics",
        "llvm20-gen-revision",
        "llvm20-gen-extension",
        "llvm20-gen-omp_gen",
        "llvm20-gen-acc_gen",
        "llvm20-gen-vt_gen",
    ],
    export_generated_headers: [
        "llvm20-gen-attributes",
        "llvm20-gen-intrinsics",
        "llvm20-gen-revision",
        "llvm20-gen-extension",
        "llvm20-gen-omp_gen",
        "llvm20-gen-acc_gen",
        "llvm20-gen-vt_gen",
    ],
    target: {
        windows: {
            enabled: true,
        },
    },
}

llvm20_min_tblgen {
    name: "llvm20-gen-attributes",
    in: "include/llvm/IR/Attributes.td",
    outs: ["llvm/IR/Attributes.inc"],
}

llvm20_min_tblgen {
    name: "llvm20-gen-intrinsics",
    in: "include/llvm/IR/Intrinsics.td",
    outs: [
        "llvm/IR/IntrinsicEnums.inc",
        "llvm/IR/IntrinsicImpl.inc",
        "llvm/IR/IntrinsicsAArch64.h",
        "llvm/IR/IntrinsicsAMDGPU.h",
        "llvm/IR/IntrinsicsARM.h",
        "llvm/IR/IntrinsicsBPF.h",
        "llvm/IR/IntrinsicsDirectX.h",
        "llvm/IR/IntrinsicsHexagon.h",
        "llvm/IR/IntrinsicsLoongArch.h",
        "llvm/IR/IntrinsicsMips.h",
        "llvm/IR/IntrinsicsNVPTX.h",
        "llvm/IR/IntrinsicsPowerPC.h",
        "llvm/IR/IntrinsicsR600.h",
        "llvm/IR/IntrinsicsRISCV.h",
        "llvm/IR/IntrinsicsS390.h",
        "llvm/IR/IntrinsicsSPIRV.h",
        "llvm/IR/IntrinsicsWebAssembly.h",
        "llvm/IR/IntrinsicsX86.h",
        "llvm/IR/IntrinsicsXCore.h",
        "llvm/IR/IntrinsicsVE.h",
    ],
}

llvm20_min_tblgen {
    name: "llvm20-gen-omp_gen",
    in: "include/llvm/Frontend/OpenMP/OMP.td",
    outs: [
        "llvm/Frontend/OpenMP/OMP.h.inc",
        "llvm/Frontend/OpenMP/OMP.inc",
    ],
}

llvm20_min_tblgen {
    name: "llvm20-gen-acc_gen",
    in: "include/llvm/Frontend/OpenACC/ACC.td",
    outs: [
        "llvm/Frontend/OpenMP/ACC.h.inc",
        "llvm/Frontend/OpenMP/ACC.inc",
    ],
}

llvm20_min_tblgen {
    name: "llvm20-gen-riscv-target-def",
    in: "lib/Target/RISCV/RISCV.td",
    outs: ["llvm/TargetParser/RISCVTargetParserDef.inc"],
}

llvm20_min_tblgen {
    name: "llvm20-gen-arm-target-def",
    in: "lib/Target/ARM/ARM.td",
    outs: ["llvm/TargetParser/ARMTargetParserDef.inc"],
}

llvm20_min_tblgen {
    name: "llvm20-gen-aarch64-target-def",
    in: "lib/Target/AArch64/AArch64.td",
    outs: ["llvm/TargetParser/AArch64TargetParserDef.inc"],
}

llvm20_min_tblgen {
    name: "llvm20-gen-vt_gen",
    in: "include/llvm/CodeGen/ValueTypes.td",
    outs: ["llvm/CodeGen/GenVT.inc"],
}

genrule {
    name: "llvm20-gen-revision",
    out: ["llvm/Support/VCSRevision.h"],
    srcs: [".git/logs/HEAD*"],
    tool_files: ["git_sha1_gen.py"],
    cmd: "python $(location git_sha1_gen.py) --output $(out)",
}

genrule {
    name: "llvm20-gen-extension",
    out: ["llvm/Support/Extension.def"],
    srcs: [".git/logs/HEAD*"],
    tool_files: ["utils/gn/secondary/llvm/include/llvm/Support/write_extension_def.py"],
    cmd: "python $(location utils/gn/secondary/llvm/include/llvm/Support/write_extension_def.py) --output $(out)",
}

force_build_llvm20_components_defaults {
    name: "force_build_llvm20_components",
    // Host build disabled by soong/llvm.go unless FORCE_BUILD_LLVM_COMPONENTS
    // environment variable is set
}

// LLVM shared library build

llvm_arm_static_libraries = [
    "libLLVM20ARMCodeGen",
    "libLLVM20ARMAsmParser",
    "libLLVM20ARMAsmPrinter",
    "libLLVM20ARMInfo",
    "libLLVM20ARMDesc",
    "libLLVM20ARMDisassembler",
    "libLLVM20ARMUtils",
]

llvm_x86_static_libraries = [
    "libLLVM20X86CodeGen",
    "libLLVM20X86Info",
    "libLLVM20X86Desc",
    "libLLVM20X86AsmParser",
    "libLLVM20X86AsmPrinter",
    "libLLVM20X86Utils",
    "libLLVM20X86Disassembler",
]

llvm_mips_static_libraries = [
    "libLLVM20MipsCodeGen",
    "libLLVM20MipsInfo",
    "libLLVM20MipsDesc",
    "libLLVM20MipsAsmParser",
    "libLLVM20MipsAsmPrinter",
    "libLLVM20MipsDisassembler",
]

llvm_aarch64_static_libraries = [
    "libLLVM20AArch64CodeGen",
    "libLLVM20AArch64Info",
    "libLLVM20AArch64Desc",
    "libLLVM20AArch64AsmParser",
    "libLLVM20AArch64AsmPrinter",
    "libLLVM20AArch64Utils",
    "libLLVM20AArch64Disassembler",
]

llvm_amdgpu_static_libraries = [
    "libLLVM20AMDGPUCodeGen",
    "libLLVM20AMDGPUInfo",
    "libLLVM20AMDGPUDesc",
    "libLLVM20AMDGPUAsmParser",
    "libLLVM20AMDGPUAsmPrinter",
    "libLLVM20AMDGPUUtils",
    "libLLVM20AMDGPUDisassembler",
]


cc_library_shared {
    host_supported: true,
    vendor_available: true,
    name: "libLLVM20",
    defaults: [
        "llvm20-defaults",
        "force_build_llvm20_components",
    ],

    whole_static_libs: [
        // pre static libraries
        "libLLVM20Linker",
        "libLLVM20ipo",
        "libLLVM20DebugInfoBTF",
        "libLLVM20DebugInfoDWARF",
        "libLLVM20DebugInfoMSF",
        "libLLVM20DebugInfoPDB",
        "libLLVM20Symbolize",
        "libLLVM20IRPrinter",
        "libLLVM20IRReader",
        "libLLVM20BitWriter",
        "libLLVM20BitReader",
        "libLLVM20Passes",
        "libLLVM20Demangle",
        "libLLVM20BitstreamReader",

        // post static libraries
        "libLLVM20LTO",
        "libLLVM20AsmPrinter",
        "libLLVM20SelectionDAG",
        "libLLVM20CodeGen",
        "libLLVM20CodeGenTypes",
        "libLLVM20DebugInfoCodeView",
        "libLLVM20Object",
        "libLLVM20ScalarOpts",
        "libLLVM20AggressiveInstCombine",
        "libLLVM20InstCombine",
        "libLLVM20Instrumentation",
        "libLLVM20TransformObjCARC",
        "libLLVM20TransformUtils",
        "libLLVM20Analysis",
        "libLLVM20Target",
        "libLLVM20TargetParser",
        "libLLVM20GlobalISel",
        "libLLVM20MCDisassembler",
        "libLLVM20MC",
        "libLLVM20MCParser",
        "libLLVM20Core",
        "libLLVM20AsmParser",
        "libLLVM20Option",
        "libLLVM20Support",
        "libLLVM20Vectorize",
        "libLLVM20ProfileData",
        "libLLVM20ProfileDataCoverage",
        "libLLVM20LibDriver",
        "libLLVM20ExecutionEngine",
        "libLLVM20RuntimeDyld",
        "libLLVM20MCJIT",
        "libLLVM20OrcJIT",
        "libLLVM20BinaryFormat",
        "libLLVM20MIRParser",
        "libLLVM20Remarks",
        "libLLVM20JITLink",
        "libLLVM20Coroutines",
        "libLLVM20TextAPI",
        "libLLVM20CFGuard",
        "libLLVM20FrontendOpenMP",
        "libLLVM20HelloNew",
        "libLLVM20OrcShared",
        "libLLVM20OrcTargetProcess",
        "libLLVM20InterfaceStub",
        "libLLVM20Debuginfod",
        "libLLVM20WindowsDriver",
        "libLLVM20HipStdPar",
        "libLLVM20FrontendOffloading",
        "libLLVM20CGData",
        "libLLVM20FrontendAtomic",
        "libLLVM20SandboxIR",
    ],

    export_include_dirs: ["include"],

    target: {
        host: {
            // Host build pulls in all ARM, Mips, X86 components.
           whole_static_libs: llvm_arm_static_libraries +
                llvm_aarch64_static_libraries +
                llvm_mips_static_libraries +
                llvm_x86_static_libraries,
            export_include_dirs: ["host/include"],
        },
        windows: {
            enabled: true,
            host_ldlibs: [
                "-limagehlp",
                "-lpsapi",
                "-lole32",
                "-lversion",
            ],
        },
        darwin: {
            host_ldlibs: [
                "-ldl",
                "-lpthread",
            ],
        },
        linux: {
            host_ldlibs: [
                "-ldl",
                "-lpthread",
            ],
        },
        android: {
            export_include_dirs: ["device/include"],
            whole_static_libs: llvm_amdgpu_static_libraries,
        },
        android_arm: {
            whole_static_libs: llvm_arm_static_libraries,
        },
        android_x86: {
            whole_static_libs: llvm_x86_static_libraries +
                llvm_arm_static_libraries +
                llvm_aarch64_static_libraries,
        },
        android_x86_64: {
            whole_static_libs: llvm_x86_static_libraries +
                llvm_arm_static_libraries +
                llvm_aarch64_static_libraries,
        },
        android_arm64: {
            whole_static_libs: llvm_aarch64_static_libraries +
                llvm_arm_static_libraries,
        },
    },
}

subdirs = [
    "soong",
    "lib",
    "utils/TableGen",
]
