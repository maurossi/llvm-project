cc_defaults {
    name: "llvm22-defaults",
    defaults: ["llvm22-defaults-no-generated-headers"],
    header_libs: ["llvm22-headers"],
}

// This module defines all of the defaults used to compiled llvm, except for
// the generated headers.  It is necessary to avoid a circular dependency
// from the tblgen tool used to generate the headers to the generated headers.
llvm_defaults {
    name: "llvm22-defaults-no-generated-headers",

    host_supported: true,

    cflags: [
        "-D_GNU_SOURCE",
        "-D__STDC_LIMIT_MACROS",
        "-D__STDC_CONSTANT_MACROS",
        "-D__STDC_FORMAT_MACROS",
        "-fomit-frame-pointer",
        "-Wall",
        "-W",
        "-Wno-sign-compare",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-maybe-uninitialized",
        "-Wno-missing-field-initializers",
        "-Wwrite-strings",
        "-Werror",
        "-Dsprintf=sprintf",
        "-DLLVM_WINDOWS_PREFER_FORWARD_SLASH=0",

        // Temporarily suppress the warnings http://b/37867503
        "-Wno-error=unused-lambda-capture",
        "-Wno-error=user-defined-warnings",
        // Avoid build error for llvm/lib/Target/AMDGPU/SIFormMemoryClauses.cpp (Android S)
        "-Wno-error=unreachable-code-loop-increment",
    ],

    cppflags: [
        "-Wno-sign-promo",
        "-std=c++17",
    ],

    header_libs: ["llvm22-headers-no-generated-headers"],

    target: {
        android: {
            cflags: [
                "-finline-functions",
            ],
            cppflags: [
                "-Woverloaded-virtual",
            ],
        },
        host: {
            cppflags: [
                "-fno-rtti",
                "-fno-exceptions",
            ],
        },
        windows: {
            // Disable certain warnings for use with mingw.
            // We also must undefine WIN32_LEAN_AND_MEAN, since it is being passed globally
            // on the command line, and LLVM defines this internally itself.
            cflags: [
                "-Wno-array-bounds",
                "-Wno-comment",
                "-UWIN32_LEAN_AND_MEAN",
            ],

            host_ldlibs: ["-luuid"],
        },
        linux: {
            cppflags: ["-Woverloaded-virtual"],

            // Add on ncurses to have support for terminfo
            host_ldlibs: [
                "-ldl",
                "-lncurses",
                "-lgcc_s",
            ],
        },
        darwin: {
            cppflags: [
                "-Wno-deprecated-declarations",
                "-Woverloaded-virtual",
            ],

            // Add on ncurses to have support for terminfo
            host_ldlibs: [
                "-ldl",
                "-lncurses",
            ],
        },
    },
}

cc_library_headers {
    name: "llvm22-headers-no-generated-headers",
    vendor_available: true,
    host_supported: true,
    export_include_dirs: ["include"],
    target: {
        android: {
            export_include_dirs: ["device/include"],
        },
        host: {
            export_include_dirs: ["host/include"],
        },
        linux_bionic: {
            enabled: true,
        },
        windows: {
            enabled: true,
        },
    },
}

cc_library_headers {
    name: "llvm22-headers",
    vendor_available: true,
    host_supported: true,
    header_libs: ["llvm22-headers-no-generated-headers"],
    export_header_lib_headers: ["llvm22-headers-no-generated-headers"],
    generated_headers: [
        "llvm22-gen-attributes",
        "llvm22-gen-intrinsics",
        "llvm22-gen-revision",
        "llvm22-gen-extension",
        "llvm22-gen-omp_gen",
        "llvm22-gen-acc_gen",
        "llvm22-gen-vt_gen",
        "llvm22-gen-runtime-libcalls",
        "llvm22-gen-analysis",
    ],
    export_generated_headers: [
        "llvm22-gen-attributes",
        "llvm22-gen-intrinsics",
        "llvm22-gen-revision",
        "llvm22-gen-extension",
        "llvm22-gen-omp_gen",
        "llvm22-gen-acc_gen",
        "llvm22-gen-vt_gen",
        "llvm22-gen-runtime-libcalls",
        "llvm22-gen-analysis",
    ],
    target: {
        windows: {
            enabled: true,
        },
    },
}

llvm22_min_tblgen {
    name: "llvm22-gen-attributes",
    in: "include/llvm/IR/Attributes.td",
    outs: ["llvm/IR/Attributes.inc"],
}

llvm22_min_tblgen {
    name: "llvm22-gen-intrinsics",
    in: "include/llvm/IR/Intrinsics.td",
    outs: [
        "llvm/IR/IntrinsicEnums.inc",
        "llvm/IR/IntrinsicImpl.inc",
        "llvm/IR/IntrinsicsAArch64.h",
        "llvm/IR/IntrinsicsAMDGPU.h",
        "llvm/IR/IntrinsicsARM.h",
        "llvm/IR/IntrinsicsBPF.h",
        "llvm/IR/IntrinsicsDirectX.h",
        "llvm/IR/IntrinsicsHexagon.h",
        "llvm/IR/IntrinsicsLoongArch.h",
        "llvm/IR/IntrinsicsMips.h",
        "llvm/IR/IntrinsicsNVPTX.h",
        "llvm/IR/IntrinsicsPowerPC.h",
        "llvm/IR/IntrinsicsR600.h",
        "llvm/IR/IntrinsicsRISCV.h",
        "llvm/IR/IntrinsicsS390.h",
        "llvm/IR/IntrinsicsSPIRV.h",
        "llvm/IR/IntrinsicsWebAssembly.h",
        "llvm/IR/IntrinsicsX86.h",
        "llvm/IR/IntrinsicsXCore.h",
        "llvm/IR/IntrinsicsVE.h",
    ],
}

llvm22_min_tblgen {
    name: "llvm22-gen-omp_gen",
    in: "include/llvm/Frontend/OpenMP/OMP.td",
    outs: [
        "llvm/Frontend/OpenMP/OMP.h.inc",
        "llvm/Frontend/OpenMP/OMP.inc",
    ],
}

llvm22_min_tblgen {
    name: "llvm22-gen-acc_gen",
    in: "include/llvm/Frontend/OpenACC/ACC.td",
    outs: [
        "llvm/Frontend/OpenMP/ACC.h.inc",
        "llvm/Frontend/OpenMP/ACC.inc",
    ],
}

llvm22_min_tblgen {
    name: "llvm22-gen-riscv-target-def",
    in: "lib/Target/RISCV/RISCV.td",
    outs: ["llvm/TargetParser/RISCVTargetParserDef.inc"],
}

llvm22_min_tblgen {
    name: "llvm22-gen-arm-target-def",
    in: "lib/Target/ARM/ARM.td",
    outs: ["llvm/TargetParser/ARMTargetParserDef.inc"],
}

llvm22_min_tblgen {
    name: "llvm22-gen-aarch64-target-def",
    in: "lib/Target/AArch64/AArch64.td",
    outs: ["llvm/TargetParser/AArch64TargetParserDef.inc"],
}

llvm22_min_tblgen {
    name: "llvm22-gen-powerpc-target-functions",
    in: "lib/Target/PowerPC/PPC.td",
    outs: ["llvm/TargetParser/PPCGenTargetFeatures.inc"],
}

llvm22_min_tblgen {
    name: "llvm22-gen-vt_gen",
    in: "include/llvm/CodeGen/ValueTypes.td",
    outs: ["llvm/CodeGen/GenVT.inc"],
}

llvm22_min_tblgen {
    name: "llvm22-gen-runtime-libcalls",
    in: "include/llvm/IR/RuntimeLibcalls.td",
    outs: ["llvm/IR/RuntimeLibcalls.inc"],
}

llvm22_min_tblgen {
    name: "llvm22-gen-analysis",
    in: "include/llvm/Analysis/TargetLibraryInfo.td",
    outs: ["llvm/Analysis/TargetLibraryInfo.inc"],
}

genrule {
    name: "llvm22-gen-revision",
    out: ["llvm/Support/VCSRevision.h"],
    srcs: [".git/logs/HEAD*"],
    tool_files: ["git_sha1_gen.py"],
    cmd: "python $(location git_sha1_gen.py) --output $(out)",
}

genrule {
    name: "llvm22-gen-extension",
    out: ["llvm/Support/Extension.def"],
    srcs: [".git/logs/HEAD*"],
    tool_files: ["utils/gn/secondary/llvm/include/llvm/Support/write_extension_def.py"],
    cmd: "python $(location utils/gn/secondary/llvm/include/llvm/Support/write_extension_def.py) --output $(out)",
}

force_build_llvm22_components_defaults {
    name: "force_build_llvm22_components",
    // Host build disabled by soong/llvm.go unless FORCE_BUILD_LLVM_COMPONENTS
    // environment variable is set
}

// LLVM shared library build

llvm_arm_static_libraries = [
    "libLLVM22ARMCodeGen",
    "libLLVM22ARMAsmParser",
    "libLLVM22ARMAsmPrinter",
    "libLLVM22ARMInfo",
    "libLLVM22ARMDesc",
    "libLLVM22ARMDisassembler",
    "libLLVM22ARMUtils",
]

llvm_x86_static_libraries = [
    "libLLVM22X86CodeGen",
    "libLLVM22X86Info",
    "libLLVM22X86Desc",
    "libLLVM22X86AsmParser",
    "libLLVM22X86AsmPrinter",
    "libLLVM22X86Utils",
    "libLLVM22X86Disassembler",
]

llvm_mips_static_libraries = [
    "libLLVM22MipsCodeGen",
    "libLLVM22MipsInfo",
    "libLLVM22MipsDesc",
    "libLLVM22MipsAsmParser",
    "libLLVM22MipsAsmPrinter",
    "libLLVM22MipsDisassembler",
]

llvm_aarch64_static_libraries = [
    "libLLVM22AArch64CodeGen",
    "libLLVM22AArch64Info",
    "libLLVM22AArch64Desc",
    "libLLVM22AArch64AsmParser",
    "libLLVM22AArch64AsmPrinter",
    "libLLVM22AArch64Utils",
    "libLLVM22AArch64Disassembler",
]

llvm_amdgpu_static_libraries = [
    "libLLVM22AMDGPUCodeGen",
    "libLLVM22AMDGPUInfo",
    "libLLVM22AMDGPUDesc",
    "libLLVM22AMDGPUAsmParser",
    "libLLVM22AMDGPUAsmPrinter",
    "libLLVM22AMDGPUUtils",
    "libLLVM22AMDGPUDisassembler",
]


cc_library_shared {
    host_supported: true,
    vendor_available: true,
    name: "libLLVM22",
    defaults: [
        "llvm22-defaults",
        "force_build_llvm22_components",
    ],

    whole_static_libs: [
        // pre static libraries
        "libLLVM22Linker",
        "libLLVM22ipo",
        "libLLVM22DebugInfoBTF",
        "libLLVM22DebugInfoDWARF",
        "libLLVM22DebugInfoDWARFLowLevel",
        "libLLVM22DebugInfoGSYM",
        "libLLVM22DebugInfoMSF",
        "libLLVM22DebugInfoPDB",
        "libLLVM22Symbolize",
        "libLLVM22IRPrinter",
        "libLLVM22IRReader",
        "libLLVM22BitWriter",
        "libLLVM22BitReader",
        "libLLVM22Passes",
        "libLLVM22PassPlugin",
        "libLLVM22Demangle",
        "libLLVM22BitstreamReader",

        // post static libraries
        "libLLVM22LTO",
        "libLLVM22AsmPrinter",
        "libLLVM22SelectionDAG",
        "libLLVM22CodeGen",
        "libLLVM22CodeGenTypes",
        "libLLVM22DebugInfoCodeView",
        "libLLVM22Object",
        "libLLVM22ScalarOpts",
        "libLLVM22AggressiveInstCombine",
        "libLLVM22InstCombine",
        "libLLVM22Instrumentation",
        "libLLVM22TransformObjCARC",
        "libLLVM22TransformUtils",
        "libLLVM22Analysis",
        "libLLVM22Target",
        "libLLVM22TargetParser",
        "libLLVM22GlobalISel",
        "libLLVM22MCDisassembler",
        "libLLVM22MC",
        "libLLVM22MCParser",
        "libLLVM22Core",
        "libLLVM22AsmParser",
        "libLLVM22Option",
        "libLLVM22Support",
        "libLLVM22Vectorize",
        "libLLVM22ProfileData",
        "libLLVM22ProfileDataCoverage",
        "libLLVM22LibDriver",
        "libLLVM22ExecutionEngine",
        "libLLVM22RuntimeDyld",
        "libLLVM22MCJIT",
        "libLLVM22OrcJIT",
        "libLLVM22BinaryFormat",
        "libLLVM22MIRParser",
        "libLLVM22Remarks",
        "libLLVM22JITLink",
        "libLLVM22Coroutines",
        "libLLVM22TextAPI",
        "libLLVM22CFGuard",
        "libLLVM22FrontendOpenMP",
        "libLLVM22HelloNew",
        "libLLVM22OrcShared",
        "libLLVM22OrcTargetProcess",
        "libLLVM22InterfaceStub",
        "libLLVM22Debuginfod",
        "libLLVM22WindowsDriver",
        "libLLVM22HipStdPar",
        "libLLVM22FrontendOffloading",
        "libLLVM22CGData",
        "libLLVM22FrontendAtomic",
        "libLLVM22SandboxIR",
        "libLLVM22ObjectYAML",
        "libLLVM22FrontendDirective",
        "libLLVM22FrontendHLSL",
    ],

    export_include_dirs: ["include"],

    target: {
        host: {
            // Host build pulls in all ARM, Mips, X86 components.
           whole_static_libs: llvm_arm_static_libraries +
                llvm_aarch64_static_libraries +
                llvm_mips_static_libraries +
                llvm_x86_static_libraries,
            export_include_dirs: ["host/include"],
        },
        windows: {
            enabled: true,
            host_ldlibs: [
                "-limagehlp",
                "-lpsapi",
                "-lole32",
                "-lversion",
            ],
        },
        darwin: {
            host_ldlibs: [
                "-ldl",
                "-lpthread",
            ],
        },
        linux: {
            host_ldlibs: [
                "-ldl",
                "-lpthread",
            ],
        },
        android: {
            export_include_dirs: ["device/include"],
            whole_static_libs: llvm_amdgpu_static_libraries,
        },
        android_arm: {
            whole_static_libs: llvm_arm_static_libraries,
        },
        android_x86: {
            whole_static_libs: llvm_x86_static_libraries +
                llvm_arm_static_libraries +
                llvm_aarch64_static_libraries,
        },
        android_x86_64: {
            whole_static_libs: llvm_x86_static_libraries +
                llvm_arm_static_libraries +
                llvm_aarch64_static_libraries,
        },
        android_arm64: {
            whole_static_libs: llvm_aarch64_static_libraries +
                llvm_arm_static_libraries,
        },
    },
}

subdirs = [
    "soong",
    "lib",
    "utils/TableGen",
]
