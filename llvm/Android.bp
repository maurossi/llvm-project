cc_defaults {
    name: "llvm23-defaults",
    defaults: ["llvm23-defaults-no-generated-headers"],
    header_libs: ["llvm23-headers"],
}

// This module defines all of the defaults used to compiled llvm, except for
// the generated headers.  It is necessary to avoid a circular dependency
// from the tblgen tool used to generate the headers to the generated headers.
llvm_defaults {
    name: "llvm23-defaults-no-generated-headers",

    host_supported: true,

    cflags: [
        "-D_GNU_SOURCE",
        "-D__STDC_LIMIT_MACROS",
        "-D__STDC_CONSTANT_MACROS",
        "-D__STDC_FORMAT_MACROS",
        "-fomit-frame-pointer",
        "-Wall",
        "-W",
        "-Wno-sign-compare",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-maybe-uninitialized",
        "-Wno-missing-field-initializers",
        "-Wwrite-strings",
        "-Werror",
        "-Dsprintf=sprintf",
        "-DLLVM_WINDOWS_PREFER_FORWARD_SLASH=0",

        // Temporarily suppress the warnings http://b/37867503
        "-Wno-error=unused-lambda-capture",
        "-Wno-error=user-defined-warnings",
        // Avoid build error for llvm/lib/Target/AMDGPU/SIFormMemoryClauses.cpp (Android S)
        "-Wno-error=unreachable-code-loop-increment",
    ],

    cppflags: [
        "-Wno-sign-promo",
        "-std=c++17",
    ],

    header_libs: ["llvm23-headers-no-generated-headers"],

    target: {
        android: {
            cflags: [
                "-finline-functions",
            ],
            cppflags: [
                "-Woverloaded-virtual",
            ],
        },
        host: {
            cppflags: [
                "-fno-rtti",
                "-fno-exceptions",
            ],
        },
        windows: {
            // Disable certain warnings for use with mingw.
            // We also must undefine WIN32_LEAN_AND_MEAN, since it is being passed globally
            // on the command line, and LLVM defines this internally itself.
            cflags: [
                "-Wno-array-bounds",
                "-Wno-comment",
                "-UWIN32_LEAN_AND_MEAN",
            ],

            host_ldlibs: ["-luuid"],
        },
        linux: {
            cppflags: ["-Woverloaded-virtual"],

            // Add on ncurses to have support for terminfo
            host_ldlibs: [
                "-ldl",
                "-lncurses",
                "-lgcc_s",
            ],
        },
        darwin: {
            cppflags: [
                "-Wno-deprecated-declarations",
                "-Woverloaded-virtual",
            ],

            // Add on ncurses to have support for terminfo
            host_ldlibs: [
                "-ldl",
                "-lncurses",
            ],
        },
    },
}

cc_library_headers {
    name: "llvm23-headers-no-generated-headers",
    vendor_available: true,
    host_supported: true,
    export_include_dirs: ["include"],
    target: {
        android: {
            export_include_dirs: ["device/include"],
        },
        host: {
            export_include_dirs: ["host/include"],
        },
        linux_bionic: {
            enabled: true,
        },
        windows: {
            enabled: true,
        },
    },
}

cc_library_headers {
    name: "llvm23-headers",
    vendor_available: true,
    host_supported: true,
    header_libs: ["llvm23-headers-no-generated-headers"],
    export_header_lib_headers: ["llvm23-headers-no-generated-headers"],
    generated_headers: [
        "llvm23-gen-attributes",
        "llvm23-gen-intrinsics",
        "llvm23-gen-revision",
        "llvm23-gen-extension",
        "llvm23-gen-omp_gen",
        "llvm23-gen-acc_gen",
        "llvm23-gen-vt_gen",
        "llvm23-gen-runtime-libcalls",
        "llvm23-gen-analysis",
    ],
    export_generated_headers: [
        "llvm23-gen-attributes",
        "llvm23-gen-intrinsics",
        "llvm23-gen-revision",
        "llvm23-gen-extension",
        "llvm23-gen-omp_gen",
        "llvm23-gen-acc_gen",
        "llvm23-gen-vt_gen",
        "llvm23-gen-runtime-libcalls",
        "llvm23-gen-analysis",
    ],
    target: {
        windows: {
            enabled: true,
        },
    },
}

llvm23_min_tblgen {
    name: "llvm23-gen-attributes",
    in: "include/llvm/IR/Attributes.td",
    outs: ["llvm/IR/Attributes.inc"],
}

llvm23_min_tblgen {
    name: "llvm23-gen-intrinsics",
    in: "include/llvm/IR/Intrinsics.td",
    outs: [
        "llvm/IR/IntrinsicEnums.inc",
        "llvm/IR/IntrinsicImpl.inc",
        "llvm/IR/IntrinsicsAArch64.h",
        "llvm/IR/IntrinsicsAMDGPU.h",
        "llvm/IR/IntrinsicsARM.h",
        "llvm/IR/IntrinsicsBPF.h",
        "llvm/IR/IntrinsicsDirectX.h",
        "llvm/IR/IntrinsicsHexagon.h",
        "llvm/IR/IntrinsicsLoongArch.h",
        "llvm/IR/IntrinsicsMips.h",
        "llvm/IR/IntrinsicsNVPTX.h",
        "llvm/IR/IntrinsicsPowerPC.h",
        "llvm/IR/IntrinsicsR600.h",
        "llvm/IR/IntrinsicsRISCV.h",
        "llvm/IR/IntrinsicsS390.h",
        "llvm/IR/IntrinsicsSPIRV.h",
        "llvm/IR/IntrinsicsWebAssembly.h",
        "llvm/IR/IntrinsicsX86.h",
        "llvm/IR/IntrinsicsXCore.h",
        "llvm/IR/IntrinsicsVE.h",
    ],
}

llvm23_min_tblgen {
    name: "llvm23-gen-omp_gen",
    in: "include/llvm/Frontend/OpenMP/OMP.td",
    outs: [
        "llvm/Frontend/OpenMP/OMP.h.inc",
        "llvm/Frontend/OpenMP/OMP.inc",
    ],
}

llvm23_min_tblgen {
    name: "llvm23-gen-acc_gen",
    in: "include/llvm/Frontend/OpenACC/ACC.td",
    outs: [
        "llvm/Frontend/OpenMP/ACC.h.inc",
        "llvm/Frontend/OpenMP/ACC.inc",
    ],
}

llvm23_min_tblgen {
    name: "llvm23-gen-riscv-target-def",
    in: "lib/Target/RISCV/RISCV.td",
    outs: ["llvm/TargetParser/RISCVTargetParserDef.inc"],
}

llvm23_min_tblgen {
    name: "llvm23-gen-arm-target-def",
    in: "lib/Target/ARM/ARM.td",
    outs: ["llvm/TargetParser/ARMTargetParserDef.inc"],
}

llvm23_min_tblgen {
    name: "llvm23-gen-aarch64-target-def",
    in: "lib/Target/AArch64/AArch64.td",
    outs: ["llvm/TargetParser/AArch64TargetParserDef.inc"],
}

llvm23_min_tblgen {
    name: "llvm23-gen-powerpc-target-functions",
    in: "lib/Target/PowerPC/PPC.td",
    outs: ["llvm/TargetParser/PPCGenTargetFeatures.inc"],
}

llvm23_min_tblgen {
    name: "llvm23-gen-vt_gen",
    in: "include/llvm/CodeGen/ValueTypes.td",
    outs: ["llvm/CodeGen/GenVT.inc"],
}

llvm23_min_tblgen {
    name: "llvm23-gen-runtime-libcalls",
    in: "include/llvm/IR/RuntimeLibcalls.td",
    outs: ["llvm/IR/RuntimeLibcalls.inc"],
}

llvm23_min_tblgen {
    name: "llvm23-gen-analysis",
    in: "include/llvm/Analysis/TargetLibraryInfo.td",
    outs: ["llvm/Analysis/TargetLibraryInfo.inc"],
}

genrule {
    name: "llvm23-gen-revision",
    out: ["llvm/Support/VCSRevision.h"],
    srcs: [".git/logs/HEAD*"],
    tool_files: ["git_sha1_gen.py"],
    cmd: "python $(location git_sha1_gen.py) --output $(out)",
}

genrule {
    name: "llvm23-gen-extension",
    out: ["llvm/Support/Extension.def"],
    srcs: [".git/logs/HEAD*"],
    tool_files: ["utils/gn/secondary/llvm/include/llvm/Support/write_extension_def.py"],
    cmd: "python $(location utils/gn/secondary/llvm/include/llvm/Support/write_extension_def.py) --output $(out)",
}

force_build_llvm23_components_defaults {
    name: "force_build_llvm23_components",
    // Host build disabled by soong/llvm.go unless FORCE_BUILD_LLVM_COMPONENTS
    // environment variable is set
}

// LLVM shared library build

llvm_arm_static_libraries = [
    "libLLVM23ARMCodeGen",
    "libLLVM23ARMAsmParser",
    "libLLVM23ARMAsmPrinter",
    "libLLVM23ARMInfo",
    "libLLVM23ARMDesc",
    "libLLVM23ARMDisassembler",
    "libLLVM23ARMUtils",
]

llvm_x86_static_libraries = [
    "libLLVM23X86CodeGen",
    "libLLVM23X86Info",
    "libLLVM23X86Desc",
    "libLLVM23X86AsmParser",
    "libLLVM23X86AsmPrinter",
    "libLLVM23X86Utils",
    "libLLVM23X86Disassembler",
]

llvm_mips_static_libraries = [
    "libLLVM23MipsCodeGen",
    "libLLVM23MipsInfo",
    "libLLVM23MipsDesc",
    "libLLVM23MipsAsmParser",
    "libLLVM23MipsAsmPrinter",
    "libLLVM23MipsDisassembler",
]

llvm_aarch64_static_libraries = [
    "libLLVM23AArch64CodeGen",
    "libLLVM23AArch64Info",
    "libLLVM23AArch64Desc",
    "libLLVM23AArch64AsmParser",
    "libLLVM23AArch64AsmPrinter",
    "libLLVM23AArch64Utils",
    "libLLVM23AArch64Disassembler",
]

llvm_amdgpu_static_libraries = [
    "libLLVM23AMDGPUCodeGen",
    "libLLVM23AMDGPUInfo",
    "libLLVM23AMDGPUDesc",
    "libLLVM23AMDGPUAsmParser",
    "libLLVM23AMDGPUAsmPrinter",
    "libLLVM23AMDGPUUtils",
    "libLLVM23AMDGPUDisassembler",
]


cc_library_shared {
    host_supported: true,
    vendor_available: true,
    name: "libLLVM23",
    defaults: [
        "llvm23-defaults",
        "force_build_llvm23_components",
    ],

    whole_static_libs: [
        // pre static libraries
        "libLLVM23Linker",
        "libLLVM23ipo",
        "libLLVM23DebugInfoBTF",
        "libLLVM23DebugInfoDWARF",
        "libLLVM23DebugInfoDWARFLowLevel",
        "libLLVM23DebugInfoGSYM",
        "libLLVM23DebugInfoMSF",
        "libLLVM23DebugInfoPDB",
        "libLLVM23Symbolize",
        "libLLVM23IRPrinter",
        "libLLVM23IRReader",
        "libLLVM23BitWriter",
        "libLLVM23BitReader",
        "libLLVM23Passes",
        "libLLVM23PassPlugin",
        "libLLVM23Demangle",
        "libLLVM23BitstreamReader",

        // post static libraries
        "libLLVM23LTO",
        "libLLVM23AsmPrinter",
        "libLLVM23SelectionDAG",
        "libLLVM23CodeGen",
        "libLLVM23CodeGenTypes",
        "libLLVM23DebugInfoCodeView",
        "libLLVM23Object",
        "libLLVM23ScalarOpts",
        "libLLVM23AggressiveInstCombine",
        "libLLVM23InstCombine",
        "libLLVM23Instrumentation",
        "libLLVM23TransformObjCARC",
        "libLLVM23TransformUtils",
        "libLLVM23Analysis",
        "libLLVM23Target",
        "libLLVM23TargetParser",
        "libLLVM23GlobalISel",
        "libLLVM23MCDisassembler",
        "libLLVM23MC",
        "libLLVM23MCParser",
        "libLLVM23Core",
        "libLLVM23AsmParser",
        "libLLVM23Option",
        "libLLVM23Support",
        "libLLVM23Vectorize",
        "libLLVM23ProfileData",
        "libLLVM23ProfileDataCoverage",
        "libLLVM23LibDriver",
        "libLLVM23ExecutionEngine",
        "libLLVM23RuntimeDyld",
        "libLLVM23MCJIT",
        "libLLVM23OrcJIT",
        "libLLVM23BinaryFormat",
        "libLLVM23MIRParser",
        "libLLVM23Remarks",
        "libLLVM23JITLink",
        "libLLVM23Coroutines",
        "libLLVM23TextAPI",
        "libLLVM23CFGuard",
        "libLLVM23FrontendOpenMP",
        "libLLVM23HelloNew",
        "libLLVM23OrcShared",
        "libLLVM23OrcTargetProcess",
        "libLLVM23InterfaceStub",
        "libLLVM23Debuginfod",
        "libLLVM23WindowsDriver",
        "libLLVM23HipStdPar",
        "libLLVM23FrontendOffloading",
        "libLLVM23CGData",
        "libLLVM23FrontendAtomic",
        "libLLVM23SandboxIR",
        "libLLVM23ObjectYAML",
        "libLLVM23FrontendDirective",
        "libLLVM23FrontendHLSL",
        "libLLVM23HTTP",
    ],

    export_include_dirs: ["include"],

    target: {
        host: {
            // Host build pulls in all ARM, Mips, X86 components.
           whole_static_libs: llvm_arm_static_libraries +
                llvm_aarch64_static_libraries +
                llvm_mips_static_libraries +
                llvm_x86_static_libraries,
            export_include_dirs: ["host/include"],
        },
        windows: {
            enabled: true,
            host_ldlibs: [
                "-limagehlp",
                "-lpsapi",
                "-lole32",
                "-lversion",
            ],
        },
        darwin: {
            host_ldlibs: [
                "-ldl",
                "-lpthread",
            ],
        },
        linux: {
            host_ldlibs: [
                "-ldl",
                "-lpthread",
            ],
        },
        android: {
            export_include_dirs: ["device/include"],
            whole_static_libs: llvm_amdgpu_static_libraries,
        },
        android_arm: {
            whole_static_libs: llvm_arm_static_libraries,
        },
        android_x86: {
            whole_static_libs: llvm_x86_static_libraries +
                llvm_arm_static_libraries +
                llvm_aarch64_static_libraries,
        },
        android_x86_64: {
            whole_static_libs: llvm_x86_static_libraries +
                llvm_arm_static_libraries +
                llvm_aarch64_static_libraries,
        },
        android_arm64: {
            whole_static_libs: llvm_aarch64_static_libraries +
                llvm_arm_static_libraries,
        },
    },
}

subdirs = [
    "soong",
    "lib",
    "utils/TableGen",
]
