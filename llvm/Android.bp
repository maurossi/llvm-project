cc_defaults {
    name: "llvm21-defaults",
    defaults: ["llvm21-defaults-no-generated-headers"],
    header_libs: ["llvm21-headers"],
}

// This module defines all of the defaults used to compiled llvm, except for
// the generated headers.  It is necessary to avoid a circular dependency
// from the tblgen tool used to generate the headers to the generated headers.
llvm_defaults {
    name: "llvm21-defaults-no-generated-headers",

    host_supported: true,

    cflags: [
        "-D_GNU_SOURCE",
        "-D__STDC_LIMIT_MACROS",
        "-D__STDC_CONSTANT_MACROS",
        "-D__STDC_FORMAT_MACROS",
        "-fomit-frame-pointer",
        "-Wall",
        "-W",
        "-Wno-sign-compare",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
        "-Wno-maybe-uninitialized",
        "-Wno-missing-field-initializers",
        "-Wwrite-strings",
        "-Werror",
        "-Dsprintf=sprintf",
        "-DLLVM_WINDOWS_PREFER_FORWARD_SLASH=0",

        // Temporarily suppress the warnings http://b/37867503
        "-Wno-error=unused-lambda-capture",
        "-Wno-error=user-defined-warnings",
        // Avoid build error for llvm/lib/Target/AMDGPU/SIFormMemoryClauses.cpp (Android S)
        "-Wno-error=unreachable-code-loop-increment",
    ],

    cppflags: [
        "-Wno-sign-promo",
        "-std=c++17",
    ],

    header_libs: ["llvm21-headers-no-generated-headers"],

    target: {
        android: {
            cflags: [
                "-finline-functions",
            ],
            cppflags: [
                "-Woverloaded-virtual",
            ],
        },
        host: {
            cppflags: [
                "-fno-rtti",
                "-fno-exceptions",
            ],
        },
        windows: {
            // Disable certain warnings for use with mingw.
            // We also must undefine WIN32_LEAN_AND_MEAN, since it is being passed globally
            // on the command line, and LLVM defines this internally itself.
            cflags: [
                "-Wno-array-bounds",
                "-Wno-comment",
                "-UWIN32_LEAN_AND_MEAN",
            ],

            host_ldlibs: ["-luuid"],
        },
        linux: {
            cppflags: ["-Woverloaded-virtual"],

            // Add on ncurses to have support for terminfo
            host_ldlibs: [
                "-ldl",
                "-lncurses",
                "-lgcc_s",
            ],
        },
        darwin: {
            cppflags: [
                "-Wno-deprecated-declarations",
                "-Woverloaded-virtual",
            ],

            // Add on ncurses to have support for terminfo
            host_ldlibs: [
                "-ldl",
                "-lncurses",
            ],
        },
    },
}

cc_library_headers {
    name: "llvm21-headers-no-generated-headers",
    vendor_available: true,
    host_supported: true,
    export_include_dirs: ["include"],
    target: {
        android: {
            export_include_dirs: ["device/include"],
        },
        host: {
            export_include_dirs: ["host/include"],
        },
        linux_bionic: {
            enabled: true,
        },
        windows: {
            enabled: true,
        },
    },
}

cc_library_headers {
    name: "llvm21-headers",
    vendor_available: true,
    host_supported: true,
    header_libs: ["llvm21-headers-no-generated-headers"],
    export_header_lib_headers: ["llvm21-headers-no-generated-headers"],
    generated_headers: [
        "llvm21-gen-attributes",
        "llvm21-gen-intrinsics",
        "llvm21-gen-revision",
        "llvm21-gen-extension",
        "llvm21-gen-omp_gen",
        "llvm21-gen-acc_gen",
        "llvm21-gen-vt_gen",
        "llvm21-gen-runtime-libcalls",
    ],
    export_generated_headers: [
        "llvm21-gen-attributes",
        "llvm21-gen-intrinsics",
        "llvm21-gen-revision",
        "llvm21-gen-extension",
        "llvm21-gen-omp_gen",
        "llvm21-gen-acc_gen",
        "llvm21-gen-vt_gen",
        "llvm21-gen-runtime-libcalls",
    ],
    target: {
        windows: {
            enabled: true,
        },
    },
}

llvm21_min_tblgen {
    name: "llvm21-gen-attributes",
    in: "include/llvm/IR/Attributes.td",
    outs: ["llvm/IR/Attributes.inc"],
}

llvm21_min_tblgen {
    name: "llvm21-gen-intrinsics",
    in: "include/llvm/IR/Intrinsics.td",
    outs: [
        "llvm/IR/IntrinsicEnums.inc",
        "llvm/IR/IntrinsicImpl.inc",
        "llvm/IR/IntrinsicsAArch64.h",
        "llvm/IR/IntrinsicsAMDGPU.h",
        "llvm/IR/IntrinsicsARM.h",
        "llvm/IR/IntrinsicsBPF.h",
        "llvm/IR/IntrinsicsDirectX.h",
        "llvm/IR/IntrinsicsHexagon.h",
        "llvm/IR/IntrinsicsLoongArch.h",
        "llvm/IR/IntrinsicsMips.h",
        "llvm/IR/IntrinsicsNVPTX.h",
        "llvm/IR/IntrinsicsPowerPC.h",
        "llvm/IR/IntrinsicsR600.h",
        "llvm/IR/IntrinsicsRISCV.h",
        "llvm/IR/IntrinsicsS390.h",
        "llvm/IR/IntrinsicsSPIRV.h",
        "llvm/IR/IntrinsicsWebAssembly.h",
        "llvm/IR/IntrinsicsX86.h",
        "llvm/IR/IntrinsicsXCore.h",
        "llvm/IR/IntrinsicsVE.h",
    ],
}

llvm21_min_tblgen {
    name: "llvm21-gen-omp_gen",
    in: "include/llvm/Frontend/OpenMP/OMP.td",
    outs: [
        "llvm/Frontend/OpenMP/OMP.h.inc",
        "llvm/Frontend/OpenMP/OMP.inc",
    ],
}

llvm21_min_tblgen {
    name: "llvm21-gen-acc_gen",
    in: "include/llvm/Frontend/OpenACC/ACC.td",
    outs: [
        "llvm/Frontend/OpenMP/ACC.h.inc",
        "llvm/Frontend/OpenMP/ACC.inc",
    ],
}

llvm21_min_tblgen {
    name: "llvm21-gen-riscv-target-def",
    in: "lib/Target/RISCV/RISCV.td",
    outs: ["llvm/TargetParser/RISCVTargetParserDef.inc"],
}

llvm21_min_tblgen {
    name: "llvm21-gen-arm-target-def",
    in: "lib/Target/ARM/ARM.td",
    outs: ["llvm/TargetParser/ARMTargetParserDef.inc"],
}

llvm21_min_tblgen {
    name: "llvm21-gen-aarch64-target-def",
    in: "lib/Target/AArch64/AArch64.td",
    outs: ["llvm/TargetParser/AArch64TargetParserDef.inc"],
}

llvm21_min_tblgen {
    name: "llvm21-gen-powerpc-target-functions",
    in: "lib/Target/PowerPC/PPC.td",
    outs: ["llvm/TargetParser/PPCGenTargetFeatures.inc"],
}

llvm21_min_tblgen {
    name: "llvm21-gen-vt_gen",
    in: "include/llvm/CodeGen/ValueTypes.td",
    outs: ["llvm/CodeGen/GenVT.inc"],
}

llvm21_min_tblgen {
    name: "llvm21-gen-runtime-libcalls",
    in: "include/llvm/IR/RuntimeLibcalls.td",
    outs: ["llvm/IR/RuntimeLibcalls.inc"],
}

genrule {
    name: "llvm21-gen-revision",
    out: ["llvm/Support/VCSRevision.h"],
    srcs: [".git/logs/HEAD*"],
    tool_files: ["git_sha1_gen.py"],
    cmd: "python $(location git_sha1_gen.py) --output $(out)",
}

genrule {
    name: "llvm21-gen-extension",
    out: ["llvm/Support/Extension.def"],
    srcs: [".git/logs/HEAD*"],
    tool_files: ["utils/gn/secondary/llvm/include/llvm/Support/write_extension_def.py"],
    cmd: "python $(location utils/gn/secondary/llvm/include/llvm/Support/write_extension_def.py) --output $(out)",
}

force_build_llvm21_components_defaults {
    name: "force_build_llvm21_components",
    // Host build disabled by soong/llvm.go unless FORCE_BUILD_LLVM_COMPONENTS
    // environment variable is set
}

// LLVM shared library build

llvm_arm_static_libraries = [
    "libLLVM21ARMCodeGen",
    "libLLVM21ARMAsmParser",
    "libLLVM21ARMAsmPrinter",
    "libLLVM21ARMInfo",
    "libLLVM21ARMDesc",
    "libLLVM21ARMDisassembler",
    "libLLVM21ARMUtils",
]

llvm_x86_static_libraries = [
    "libLLVM21X86CodeGen",
    "libLLVM21X86Info",
    "libLLVM21X86Desc",
    "libLLVM21X86AsmParser",
    "libLLVM21X86AsmPrinter",
    "libLLVM21X86Utils",
    "libLLVM21X86Disassembler",
]

llvm_mips_static_libraries = [
    "libLLVM21MipsCodeGen",
    "libLLVM21MipsInfo",
    "libLLVM21MipsDesc",
    "libLLVM21MipsAsmParser",
    "libLLVM21MipsAsmPrinter",
    "libLLVM21MipsDisassembler",
]

llvm_aarch64_static_libraries = [
    "libLLVM21AArch64CodeGen",
    "libLLVM21AArch64Info",
    "libLLVM21AArch64Desc",
    "libLLVM21AArch64AsmParser",
    "libLLVM21AArch64AsmPrinter",
    "libLLVM21AArch64Utils",
    "libLLVM21AArch64Disassembler",
]

llvm_amdgpu_static_libraries = [
    "libLLVM21AMDGPUCodeGen",
    "libLLVM21AMDGPUInfo",
    "libLLVM21AMDGPUDesc",
    "libLLVM21AMDGPUAsmParser",
    "libLLVM21AMDGPUAsmPrinter",
    "libLLVM21AMDGPUUtils",
    "libLLVM21AMDGPUDisassembler",
]


cc_library_shared {
    host_supported: true,
    vendor_available: true,
    name: "libLLVM21",
    defaults: [
        "llvm21-defaults",
        "force_build_llvm21_components",
    ],

    whole_static_libs: [
        // pre static libraries
        "libLLVM21Linker",
        "libLLVM21ipo",
        "libLLVM21DebugInfoBTF",
        "libLLVM21DebugInfoDWARF",
        "libLLVM21DebugInfoDWARFLowLevel",
        "libLLVM21DebugInfoGSYM",
        "libLLVM21DebugInfoMSF",
        "libLLVM21DebugInfoPDB",
        "libLLVM21Symbolize",
        "libLLVM21IRPrinter",
        "libLLVM21IRReader",
        "libLLVM21BitWriter",
        "libLLVM21BitReader",
        "libLLVM21Passes",
        "libLLVM21Demangle",
        "libLLVM21BitstreamReader",

        // post static libraries
        "libLLVM21LTO",
        "libLLVM21AsmPrinter",
        "libLLVM21SelectionDAG",
        "libLLVM21CodeGen",
        "libLLVM21CodeGenTypes",
        "libLLVM21DebugInfoCodeView",
        "libLLVM21Object",
        "libLLVM21ScalarOpts",
        "libLLVM21AggressiveInstCombine",
        "libLLVM21InstCombine",
        "libLLVM21Instrumentation",
        "libLLVM21TransformObjCARC",
        "libLLVM21TransformUtils",
        "libLLVM21Analysis",
        "libLLVM21Target",
        "libLLVM21TargetParser",
        "libLLVM21GlobalISel",
        "libLLVM21MCDisassembler",
        "libLLVM21MC",
        "libLLVM21MCParser",
        "libLLVM21Core",
        "libLLVM21AsmParser",
        "libLLVM21Option",
        "libLLVM21Support",
        "libLLVM21Vectorize",
        "libLLVM21ProfileData",
        "libLLVM21ProfileDataCoverage",
        "libLLVM21LibDriver",
        "libLLVM21ExecutionEngine",
        "libLLVM21RuntimeDyld",
        "libLLVM21MCJIT",
        "libLLVM21OrcJIT",
        "libLLVM21BinaryFormat",
        "libLLVM21MIRParser",
        "libLLVM21Remarks",
        "libLLVM21JITLink",
        "libLLVM21Coroutines",
        "libLLVM21TextAPI",
        "libLLVM21CFGuard",
        "libLLVM21FrontendOpenMP",
        "libLLVM21HelloNew",
        "libLLVM21OrcShared",
        "libLLVM21OrcTargetProcess",
        "libLLVM21InterfaceStub",
        "libLLVM21Debuginfod",
        "libLLVM21WindowsDriver",
        "libLLVM21HipStdPar",
        "libLLVM21FrontendOffloading",
        "libLLVM21CGData",
        "libLLVM21FrontendAtomic",
        "libLLVM21SandboxIR",
        "libLLVM21ObjectYAML",
        "libLLVM21FrontendDirective",
    ],

    export_include_dirs: ["include"],

    target: {
        host: {
            // Host build pulls in all ARM, Mips, X86 components.
           whole_static_libs: llvm_arm_static_libraries +
                llvm_aarch64_static_libraries +
                llvm_mips_static_libraries +
                llvm_x86_static_libraries,
            export_include_dirs: ["host/include"],
        },
        windows: {
            enabled: true,
            host_ldlibs: [
                "-limagehlp",
                "-lpsapi",
                "-lole32",
                "-lversion",
            ],
        },
        darwin: {
            host_ldlibs: [
                "-ldl",
                "-lpthread",
            ],
        },
        linux: {
            host_ldlibs: [
                "-ldl",
                "-lpthread",
            ],
        },
        android: {
            export_include_dirs: ["device/include"],
            whole_static_libs: llvm_amdgpu_static_libraries,
        },
        android_arm: {
            whole_static_libs: llvm_arm_static_libraries,
        },
        android_x86: {
            whole_static_libs: llvm_x86_static_libraries +
                llvm_arm_static_libraries +
                llvm_aarch64_static_libraries,
        },
        android_x86_64: {
            whole_static_libs: llvm_x86_static_libraries +
                llvm_arm_static_libraries +
                llvm_aarch64_static_libraries,
        },
        android_arm64: {
            whole_static_libs: llvm_aarch64_static_libraries +
                llvm_arm_static_libraries,
        },
    },
}

subdirs = [
    "soong",
    "lib",
    "utils/TableGen",
]
