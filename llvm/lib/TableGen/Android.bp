cc_library_static {
    name: "libLLVM21TableGen",
    defaults: ["llvm21-defaults-no-generated-headers"],
    srcs: ["*.cpp"],
    target: {
        // llvm21-defaults turns off host builds by default, turn it back on for
        // modules that are used to build llvm21-tblgen
        host: {
            enabled: true,
        },
    },
}
