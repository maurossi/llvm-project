cc_library_static {
    name: "libLLVM23TableGen",
    defaults: ["llvm23-defaults-no-generated-headers"],
    srcs: ["*.cpp"],
    target: {
        // llvm23-defaults turns off host builds by default, turn it back on for
        // modules that are used to build llvm23-tblgen
        host: {
            enabled: true,
        },
    },
}
