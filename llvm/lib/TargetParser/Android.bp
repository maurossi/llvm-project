cc_library_static {
    name: "libLLVM21TargetParser",
    vendor_available: true,
    defaults: ["llvm21-defaults-no-generated-headers"],
    target: {
        // llvm21-defaults turns off host builds by default, turn it back on for
        // modules that are used to build llvm21-tblgen
        host: {
            enabled: true,
        },
        windows: {
            enabled: true,
        },
    },
    generated_headers: [
        "llvm21-gen-arm-target-def",
        "llvm21-gen-aarch64-target-def",
        "llvm21-gen-riscv-target-def",
        "llvm21-gen-powerpc-target-functions",
    ],
    srcs: [
        "*.cpp",
    ],
}
