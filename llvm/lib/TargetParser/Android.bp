cc_library_static {
    name: "libLLVM23TargetParser",
    vendor_available: true,
    defaults: ["llvm23-defaults-no-generated-headers"],
    target: {
        // llvm23-defaults turns off host builds by default, turn it back on for
        // modules that are used to build llvm23-tblgen
        host: {
            enabled: true,
        },
        windows: {
            enabled: true,
        },
    },
    generated_headers: [
        "llvm23-gen-arm-target-def",
        "llvm23-gen-aarch64-target-def",
        "llvm23-gen-riscv-target-def",
        "llvm23-gen-powerpc-target-functions",
    ],
    srcs: [
        "*.cpp",
    ],
}
