cc_library_static {
    name: "libLLVM20TargetParser",
    vendor_available: true,
    defaults: ["llvm20-defaults-no-generated-headers"],
    target: {
        // llvm20-defaults turns off host builds by default, turn it back on for
        // modules that are used to build llvm20-tblgen
        host: {
            enabled: true,
        },
        windows: {
            enabled: true,
        },
    },
    generated_headers: [
        "llvm20-gen-arm-target-def",
        "llvm20-gen-aarch64-target-def",
        "llvm20-gen-riscv-target-def",
    ],
    srcs: [
        "*.cpp",
    ],
}
