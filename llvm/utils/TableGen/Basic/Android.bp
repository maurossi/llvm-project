cc_library_static {
    name: "libLLVM20TableGenBasic",
    defaults: ["llvm20-defaults-no-generated-headers"],
    header_libs: ["llvm20-tblgen-headers"],
    srcs: ["*.cpp"],

    whole_static_libs: [
        "libLLVM20Support",
        "libLLVM20TableGen",
    ],

    host_ldlibs: ["-lm"],
    target: {
        windows: {
            enabled: false,
        },
        // llvm20-defaults turns off host builds by default, turn it back on for
        // modules that are used to build llvm20-tblgen
        host: {
            enabled: true,
        },
        darwin: {
            host_ldlibs: [
                "-lpthread",
                "-ldl",
            ],
        },
        linux: {
            host_ldlibs: [
                "-lpthread",
                "-ldl",
            ],
        },
    },
}
