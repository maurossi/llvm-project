cc_library_static {
    name: "libLLVM20TableGenCommon",
    defaults: ["llvm20-defaults-no-generated-headers"],
    header_libs: [
        "llvm20-tblgen-headers",
        "llvm20-headers",
    ],
    srcs: [
        "GlobalISel/*.cpp",
        "*.cpp",
    ],

    static_libs: [
        "libLLVM20Support",
    ],

    host_ldlibs: ["-lm"],
    target: {
        windows: {
            enabled: false,
        },
        // llvm20-defaults turns off host builds by default, turn it back on for
        // modules that are used to build llvm20-tblgen
        host: {
            enabled: true,
        },
        darwin: {
            host_ldlibs: [
                "-lpthread",
                "-ldl",
            ],
        },
        linux: {
            host_ldlibs: [
                "-lpthread",
                "-ldl",
            ],
        },
    },
}
