cc_library_static {
    name: "libLLVM21TableGenCommon",
    defaults: ["llvm21-defaults-no-generated-headers"],
    header_libs: [
        "llvm21-tblgen-headers",
        "llvm21-headers",
    ],
    srcs: [
        "GlobalISel/*.cpp",
        "*.cpp",
    ],

    static_libs: [
        "libLLVM21Support",
    ],

    host_ldlibs: ["-lm"],
    target: {
        windows: {
            enabled: false,
        },
        // llvm21-defaults turns off host builds by default, turn it back on for
        // modules that are used to build llvm21-tblgen
        host: {
            enabled: true,
        },
        darwin: {
            host_ldlibs: [
                "-lpthread",
                "-ldl",
            ],
        },
        linux: {
            host_ldlibs: [
                "-lpthread",
                "-ldl",
            ],
        },
    },
}
